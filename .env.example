# Copy to .env and fill in (optional — keys can also be added via CLI/dashboard)
# Set HERMUS_MODEL (provider/model) when you want a non-local default.
# HERMUS_MODEL=openrouter/openrouter/auto
#
# Any of these keys are auto-discovered by Hermus at runtime — you do NOT need
# to also run `hermus multikey add` for them. They make the provider resolver,
# tool fallback, model fleet and router see the provider as configured.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=AIza...
# NVIDIA_API_KEY=nvapi-...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
# CODESTRAL_API_KEY=...
# CEREBRAS_API_KEY=...
# SAMBANOVA_API_KEY=...
# HF_TOKEN=hf_...
# ANTHROPIC_API_KEY=sk-ant-...
#
# Auto-select a compatible tool-capable provider/model when the current one is
# unusable (recommended). Set 0 to keep the current model no matter what.
# HERMUS_AUTO_SELECT_MODEL=1
#
# TELEGRAM_BOT_TOKEN=123:ABC
# DISCORD_BOT_TOKEN=...
# HERMUS_GATEWAY_TOKEN=change-me
# If you register the Telegram webhook with setWebhook's secret_token, set the
# same secret here so /webhook/telegram validates X-Telegram-Bot-Api-Secret-Token.
# HERMUS_TELEGRAM_WEBHOOK_SECRET=change-me
# HERMUS_MAX_TOOL_STEPS=8
# Chat/multi-chat turns are held to a much tighter tool budget than agent turns.
# Raise to let a chat message run long tool chains too (clamped to max_tool_steps).
# HERMUS_CHAT_MAX_STEPS=2
# The reasoning governor normally grants only a difficulty-scaled SHARE of
# max_tool_steps (6.25% .. 100%). Set 1 to grant the full budget to every task.
# HERMUS_STEP_BUDGET_FULL=0
# HERMUS_TELEGRAM_MODE=auto

# Fullscreen Talking Operations mode — local backend audio (optional)
# auto | piper | espeak | pyttsx3
# HERMUS_TTS_BACKEND=auto
# Piper gives higher-quality neural speech; point this at a downloaded .onnx voice.
# HERMUS_PIPER_MODEL=/absolute/path/to/en_US-lessac-medium.onnx
# Generated WAV files are private local artifacts and expire via service cleanup.
# --- Voice-first (Jarvis) mode ----------------------------------------------
# POST /voice/command transcribes, speaks a short acknowledgment, then queues
# the real work as a `voice.reply` job — so you hear a reply in well under a
# second instead of waiting out a full tool-carrying agent turn.
# HERMUS_VOICE_ENABLED=1
# canned = local phrase pool, no model call (fastest) | llm = tools-free model
# call (personalised, pays model latency) | off = no acknowledgment
# HERMUS_VOICE_ACK_MODE=canned
# HERMUS_VOICE_ACK_PHRASES=On it.|Give me a second.|Working on that now.|Sure, one moment.|Right away.
# Synthesize the final answer for speech when the job finishes.
# HERMUS_VOICE_SPEAK_ANSWER=1
# Speech-only truncation — the full answer stays in the transcript/job result.
# HERMUS_VOICE_ANSWER_MAX_CHARS=900
# HERMUS_VOICE_STT_MODEL=base

# --- Hands-free voice loop (always-listening) ---
# Off by default on purpose: arming this holds the browser microphone open for as
# long as the Voice tab stays armed, and every detected utterance is sent to
# speech-to-text before the wake word is even checked.
# HERMUS_VOICE_HANDSFREE=1
# Must start an utterance before it is acted on. Ambient speech is transcribed
# and then discarded without reaching the model.
# HERMUS_VOICE_WAKE_WORD=jarvis
# Comma-separated mistranscriptions your STT actually produces for the wake word.
# The matcher allows ~2 character edits; anything further out belongs here rather
# than in a looser budget, which would let ordinary words un-gate the mic.
# HERMUS_VOICE_WAKE_ALIASES=jervis,jarviss
# Set to 0 to act on everything you say (no wake word).
# HERMUS_VOICE_WAKE_REQUIRED=1
# Trailing silence (ms) that ends an utterance; sustained voice (ms) that starts
# one; bounds on how short/long an utterance may be.
# HERMUS_VOICE_SILENCE_MS=900
# HERMUS_VOICE_SPEECH_MS=140
# HERMUS_VOICE_MIN_UTTERANCE_MS=350
# HERMUS_VOICE_MAX_UTTERANCE_MS=20000
# Talking over the assistant stops its playback and cancels the running job.
# HERMUS_VOICE_BARGE_IN=1

# --- Per-turn tool selection ---
# Ship only the tools this request could plausibly use instead of all ~179
# schemas (~18.3K of a ~19.9K prompt, re-sent every step). The model can call
# `expand_tools` to get the full catalog back if the subset is missing something.
# Set to 0 to always send everything.
# HERMUS_TOOL_SUBSET=1
# HERMUS_TOOL_SUBSET_LIMIT=40
# HERMUS_SPEECH_DIR=data/speech
# HERMUS_SPEECH_MAX_AGE_HOURS=24

# --- Hybrid memory + decay (retrieval) -------------------------------------
# FTS5/BM25 + dense vectors fused with Reciprocal Rank Fusion for recall.
# HERMUS_MEMORY_HYBRID=1
# Store per-memory float32 embeddings (sqlite-vec if installed, else cosine scan).
# HERMUS_MEMORY_VECTORS=1
# Recency half-life in days; it lengthens with access count (adaptive decay).
# HERMUS_MEMORY_HALF_LIFE_DAYS=30
# Decay multiplier floor — a memory is never fully silenced.
# HERMUS_MEMORY_DECAY_FLOOR=0.35
# Token budget for memories injected into the system prompt.
# HERMUS_MEMORY_BUDGET_TOKENS=600
# Bands: below these multipliers a memory is archived / purged by the sweeper.
# HERMUS_MEMORY_ARCHIVE_BELOW=0.08
# HERMUS_MEMORY_PURGE_BELOW=0.02
# working-memory rows older than this are swept first.
# HERMUS_MEMORY_WORKING_TTL_HOURS=48
# RRF constant and the weight of the stored importance prior.
# HERMUS_MEMORY_RRF_K=60
# HERMUS_MEMORY_PRIOR_WEIGHT=0.35
# Gateway maintenance loop cadence (0 disables it).
# HERMUS_MEMORY_SWEEP_MINUTES=60
# Embedding provider: auto | ollama | openai | hash (hash = offline, no deps)
# HERMUS_EMBED_BACKEND=auto
# HERMUS_EMBED_MODEL=nomic-embed-text

# --- Skill forge: successful trajectories become SKILL.md ------------------
# HERMUS_SKILL_FORGE=1
# Minimum tool calls before a run is worth distilling into a skill.
# HERMUS_SKILL_FORGE_MIN_TOOLS=3
# Let the LLM rewrite the distilled steps (template fallback if off/unavailable).
# HERMUS_SKILL_FORGE_LLM=1
# Merge instead of duplicating when a similar skill exists (cosine).
# HERMUS_SKILL_FORGE_DEDUPE=0.72
# Cap on kept harvested skills (oldest/lowest value retired first).
# HERMUS_SKILL_FORGE_MAX=200

# --- Gateway queue + real-time streaming -----------------------------------
# Decouple intake from execution: webhooks return 202, workers run the job.
# HERMUS_QUEUE_ENABLED=1
# HERMUS_QUEUE_WORKERS=4
# HERMUS_QUEUE_MAXSIZE=500
# Per-job wall clock; a timeout cancels the agent cooperatively.
# HERMUS_QUEUE_TIMEOUT=300
# HERMUS_QUEUE_RETRY_BACKOFF=1.5
# Grace given to a cancelled job before its worker is abandoned.
# HERMUS_QUEUE_CANCEL_GRACE=15
# inprocess | redis (redis is optional; falls back automatically)
# HERMUS_QUEUE_BACKEND=inprocess
# Durable job log (results/ lives beside it).
# HERMUS_QUEUE_LOG=data/jobs/jobs.jsonl
# REDIS_URL=redis://localhost:6379/0
# SSE / WebSocket streaming of tokens and step events.
# HERMUS_STREAM_ENABLED=1
# HERMUS_STREAM_TOKENS=1
# Set to 1 to make /webhook/telegram run inline (debugging).
# HERMUS_WEBHOOK_SYNC=0

# --- Sandboxed tool execution --------------------------------------------
# auto | docker | podman | bwrap | local | off  (off = run unsandboxed)
# HERMUS_SANDBOX=auto
# HERMUS_SANDBOX_IMAGE=python:3.11-alpine
# HERMUS_SANDBOX_CPUS=1.0
# HERMUS_SANDBOX_MEMORY_MB=1024
# HERMUS_SANDBOX_PIDS=128
# HERMUS_SANDBOX_TIMEOUT=60
# HERMUS_SANDBOX_DISK_MB=256
# HERMUS_SANDBOX_NETWORK=0
# HERMUS_SANDBOX_RO_ROOTFS=1
# HERMUS_SANDBOX_WORKSPACE_RW=1
# OCI runtime for hardened containers, e.g. runsc (gVisor) or kata.
# HERMUS_SANDBOX_RUNTIME=

# --- Hierarchical sub-agent delegation ------------------------------------
# HERMUS_DELEGATION=1
# HERMUS_DELEGATION_WORKERS=4
# Children may themselves delegate until this depth is exhausted.
# HERMUS_DELEGATION_MAX_DEPTH=2
# HERMUS_DELEGATION_TIMEOUT=120
# Talk JSON-RPC to child processes (structured results across processes).
# HERMUS_DELEGATION_RPC=1
