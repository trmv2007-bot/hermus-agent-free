# Hermus — raised numeric ceilings
#
# Copy into .env (or append to it) to lift the runtime caps.
#   cp .env.limits.example .env
#
# Every value below is a real env var read by core/config.py — no code change is
# needed to raise any of them. 39 of the 41 numeric ceilings in Config are
# env-overridable; only auto_skill_threshold and the two port numbers are not.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ DO NOT USE 0 TO MEAN "UNLIMITED" — there is no unlimited sentinel.
#   Verified against the live code:
#     HERMUS_MAX_TOOL_STEPS=0      -> governor.step_budget() returns 1, and the
#                                     agent loop is `while steps < budget_steps`,
#                                     so tool use collapses to ~1 step.
#     HERMUS_DELEGATION_MAX_DEPTH=0 -> `depth >= max_depth` is true at depth 0,
#                                     so Delegation.can_delegate() returns False
#                                     and delegation is disabled outright.
#     HERMUS_SANDBOX_TIMEOUT=0      -> subprocess.run(timeout=0) fires at once;
#                                     even `echo hello` returns rc=124 timed_out.
#   To lift a ceiling, set a large finite number. To truly remove enforcement you
#   have to change the code, not the value.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ TIER 1 — autonomy & cost budgets ════════════════════════════════════════
# Safe to raise freely. The only cost is tokens/wall-clock: with ~20K prompt
# tokens per call, a bigger budget means a bigger bill, not a broken machine.

HERMUS_MAX_TOOL_STEPS=200            # was 32   — tool calls per agent turn
HERMUS_MISSION_BUDGET_STEPS=400      # was 48   — steps per mission
HERMUS_QUEUE_TIMEOUT=3600            # was 300  — per-job wall clock (seconds)
HERMUS_QUEUE_WORKERS=16              # was 4    — concurrent jobs
HERMUS_QUEUE_MAXSIZE=5000            # was 500  — backlog depth
HERMUS_DELEGATION_TIMEOUT=1800       # was 120  — per sub-agent (seconds)
HERMUS_DELEGATION_WORKERS=16         # was 4    — parallel sub-agents
HERMUS_DOCTOR_DAILY_CAP=200          # was 12   — self-repair attempts/day
HERMUS_DOCTOR_COOLDOWN_MIN=1         # was 15   — between self-repair attempts
HERMUS_DOCTOR_STUCK_MIN=120          # was 20   — before work is called stuck


# ═══ TIER 2 — reasoning & memory breadth ═════════════════════════════════════
# Safe to raise. These widen context, which raises per-call token cost.

HERMUS_DELEGATION_MAX_DEPTH=5        # was 2    — sub-agent nesting levels
HERMUS_COUNSEL_MAX_MEMBERS=12        # was 6    — multi-agent council size
HERMUS_COUNSEL_MAX_ROUNDS=8          # was 3    — debate rounds
HERMUS_SELF_CONSISTENCY_K=5          # was 3    — sampled answers per decision
HERMUS_LESSONS_IN_PROMPT=40          # was 8    — lessons injected per prompt
HERMUS_MEMORY_BUDGET_TOKENS=4000     # was 600  — memory injected per prompt
HERMUS_VERIFY_THRESHOLD=8            # was 4    — evidence needed to pass verify
HERMUS_SKILL_FORGE_MAX=5000          # was 200  — harvested skills retained
HERMUS_MEMORY_SWEEP_MINUTES=0        # was 60   — 0 disables the sweep loop
HERMUS_MEMORY_WORKING_TTL_HOURS=0    # was 48   — see note on forgetting below

# Two caps live in code, not in config, and need these dedicated knobs:
HERMUS_CHAT_MAX_STEPS=50             # was hard-coded min(2, max_tool_steps)
HERMUS_STEP_BUDGET_FULL=1            # grant full budget, not a difficulty share
                                     # (governor shares: 6.25/12.5/25/50/100%)

# Note: setting the sweep/TTL to 0 stops the *maintenance loop*, it does not stop
# decay scoring. Memories below memory_archive_below (0.08) / memory_purge_below
# (0.02) are still archived/purged when a sweep does run. To keep everything
# forever, also lower these two:
#   HERMUS_MEMORY_ARCHIVE_BELOW=0.0
#   HERMUS_MEMORY_PURGE_BELOW=0.0


# ═══ TIER 3 — sandbox host protection ════════════════════════════════════════
# READ THIS TIER BEFORE RAISING IT.
#
# These five are not autonomy limits — they are the wall between code the agent
# writes and your actual machine. `sandbox_pids` in particular is what stops a
# runaway loop or fork bomb from hanging the host, and `sandbox_timeout` is what
# stops an infinite loop from running forever. Raising them is reasonable;
# removing them means an agent-authored `while True` or a memory hog can take
# down your box, and there is no second line of defence behind them.
#
# Sized generously below. Scale to YOUR machine — `nproc`, `free -m`, `df -h`.

HERMUS_SANDBOX_CPUS=4                # was 1.0
HERMUS_SANDBOX_MEMORY_MB=8192        # was 1024
HERMUS_SANDBOX_PIDS=1024             # was 128  — keep this non-zero
HERMUS_SANDBOX_DISK_MB=8192          # was 256
HERMUS_SANDBOX_TIMEOUT=1800          # was 60   — keep this non-zero


# ═══ Not ceilings — listed for completeness ══════════════════════════════════
# gateway_port (8000), nollama_port (8010) and auto_skill_threshold (3) have no
# env var. The ports are addresses, not limits. auto_skill_threshold is the only
# genuine numeric ceiling in Config that requires a code edit to change.
