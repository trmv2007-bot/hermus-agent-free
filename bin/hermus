#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

# Always invoke the interpreter selected by setup/bootstrap. Falling back to
# ambient Python is only for the first bootstrap invocation before .venv exists;
# bootstrap then re-execs itself inside the new environment.
if [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" "$ROOT/hermus.py" "$@"
elif [ -x "$ROOT/.venv/Scripts/python.exe" ]; then
  exec "$ROOT/.venv/Scripts/python.exe" "$ROOT/hermus.py" "$@"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/hermus.py" "$@"
else
  exec python "$ROOT/hermus.py" "$@"
fi
