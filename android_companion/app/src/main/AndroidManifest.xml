<?xml version="1.0" encoding="utf-8"?>
<!--
  HERMUS Android Agent Companion — manifest.

  This app exposes a user-consented local bridge that Hermus (the backend) uses to
  observe (screenshot / UI hierarchy) and drive (tap / type / key / launch) the
  device. Every capability is gated behind a runtime user grant and the app never
  performs a covert action. No privilege the OS does not expose is requested.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ACCESSIBILITY: required to read the UI hierarchy and perform tap/type/key
         gestures. It is the documented, user-granted Android API for this. -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!-- MEDIA PROJECTION: required for screen capture (user consents via a system
         dialog whenever a capture is requested, using the documented API). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The bridge listens on loopback only by default. Hermus on the same device
         (or via adb reverse on a host) connects to it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- Accessibility service: UI hierarchy + gesture injection with consent. -->
        <service
            android:name=".accessibility.HermusAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Bridge foreground service: hosts the local control socket. -->
        <service
            android:name=".bridge.HermusBridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="com.hermus.companion.BRIDGE" />
            </intent-filter>
        </service>

        <!-- Pairing / consent activity. -->
        <activity
            android:name=".ui.PairingActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
